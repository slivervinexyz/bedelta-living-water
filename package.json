{
  "name": "@slivervine/exomesh-agentic-wallet-guard",
  "version": "1.0.0",
  "description": "SliverVine Protocol — @slivervine/exomesh-agentic-wallet-guard · Universal EIP-1193 Pre-Consensus Guard (SilverVine Labs)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm clean:coverage && mkdir -p coverage && vitest run --dir . --coverage",
    "test:watch": "vitest",
    "test:zerodev": "vitest run tests/adapters/zerodev-aa-dryrun-harness.test.ts",
    "test:grant-v09-sim": "vitest run tests/v09/grant-v09-risk.test.ts tests/v09/opsec-boundary.test.ts tests/v09/aa-pipeline-opsec.test.ts",
    "test:wasm-feasibility": "vitest run tests/services/wasm-feasibility-simulation.test.ts tests/services/wasm-feasibility-lib/soil-core-sim.test.ts",
    "typecheck": "tsc --noEmit",
    "audit:fast": "tsx scripts/run-security-matrix.ts --tier=fast",
    "audit:security": "tsx scripts/run-security-matrix.ts --tier=security",
    "audit:nightly": "tsx scripts/run-security-matrix.ts --tier=nightly",
    "audit:slither": "bash scripts/run-static-analysis.sh --slither",
    "audit:grant": "tsx scripts/generate-grant-audit-matrix.ts",
    "audit:sepsb": "tsx scripts/sepsb-benchmark-runner.ts && pnpm sync:docs",
    "sync:docs": "tsx scripts/sync-ssot-docs.ts",
    "docs:fix-links": "tsx scripts/fix-public-doc-links.ts",
    "docs:fix-links:dry": "tsx scripts/fix-public-doc-links.ts --dry-run",
    "docs:link-audit": "tsx scripts/docs-link-audit.ts",
    "docs:math-audit": "tsx scripts/docs-math-audit.ts",
    "docs:metrics-audit": "tsx scripts/docs-metrics-audit.ts",
    "docs:commit-audit": "tsx scripts/docs-commit-audit.ts",
    "docs:dune-reconcile": "tsx scripts/docs-dune-reconcile.ts",
    "demo": "vitest run tests/demo/",
    "demo:gmx": "tsx examples/gmx-demo.ts",
    "demo:hl": "tsx examples/hyperliquid-demo.ts",
    "demo:pendle": "tsx examples/pendle-demo.ts",
    "demo:usdai": "tsx examples/usdai-demo.ts",
    "demo:sanctuary": "tsx examples/sanctuary-demo.ts",
    "demo:escort": "pnpm demo:sanctuary",
    "demo:ingress": "tsx examples/ingress-escort-demo.ts",
    "demo:variational": "tsx examples/variational-demo.ts",
    "demo:perp-loop": "tsx examples/matrix-cross-venue-demo.ts --loop=perp",
    "demo:spot-loop": "tsx examples/matrix-cross-venue-demo.ts --loop=spot",
    "demo:agent": "tsx examples/agent-interceptor-demo.ts",
    "demo:exomesh": "tsx examples/eip1193-provider-demo.ts",
    "demo:FW-01": "pnpm demo:pendle -- --trip",
    "demo:FW-02": "vitest run tests/services/session-key-gates.test.ts",
    "demo:FW-04": "vitest run tests/services/cross-venue-fail-safe.test.ts",
    "demo:FW-10": "vitest run tests/services/gateway-lock-hud.test.ts",
    "demo:FW-11": "vitest run tests/sdk/retail-guard-provider.test.ts",
    "demo:FW-11-ui": "node scripts/demo-ui/serve.mjs",
    "test:e2e": "node scripts/playwright-run.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:deps": "playwright install-deps chromium",
    "test:e2e:libs": "node scripts/playwright-user-libs.mjs",
    "demo:FW-12": "vitest run tests/sdk/eip5792-send-calls.test.ts",
    "demo:FW-13": "pnpm demo:exomesh -- --trip",
    "demo:FW-14": "pnpm demo:sanctuary",
    "demo:FW-all": "tsx scripts/fw-demo-runner.ts --mode=all",
    "demo:FW-menu": "tsx scripts/fw-demo-runner.ts --mode=menu",
    "demo:delta-neutral": "tsx scripts/grant-delta-neutral-demo.ts",
    "telemetry:96h": "tsx scripts/live-96h-telemetry-daemon.ts",
    "build:wasm": "cargo build --manifest-path src/wasm/Cargo.toml --release --target wasm32-unknown-unknown && mkdir -p pkg && cp src/wasm/target/wasm32-unknown-unknown/release/soil_core.wasm pkg/soil_core.wasm",
    "build:stylus": "cd contracts/stylus-probe && cargo test stylus_core --release && cargo build --target wasm32-unknown-unknown --release",
    "deploy:stylus:testnet": "cd contracts/stylus-probe && cargo stylus check && cargo stylus deploy",
    "build:sanctuary-invariants": "cargo build --manifest-path contracts/sanctuary_invariants/Cargo.toml --release --target wasm32-unknown-unknown --no-default-features --features host-export && mkdir -p pkg && cp contracts/sanctuary_invariants/target/wasm32-unknown-unknown/release/sanctuary_invariants.wasm pkg/sanctuary_invariants.wasm",
    "deploy:policy-guard-v2": "tsx scripts/deploy-policy-guard-v2-mainnet.ts",
    "link:gate-policy-guard-v2": "tsx scripts/link-gate-policy-guard-v2.ts",
    "execute:gmx:micro-fill": "tsx scripts/execute-gmx-mainnet-micro-fill.ts",
    "execute:gmx:micro-fill-decrease": "tsx scripts/live-gmx-decrease-execution.ts",
    "execute:gmx:gm-deposit": "tsx scripts/execute-gmx-mainnet-gm-deposit.ts",
    "execute:gmx:gm-withdraw": "tsx scripts/execute-gmx-mainnet-gm-withdraw.ts",
    "execute:gmx:wallet-a-short-fallback": "tsx scripts/execute-gmx-wallet-a-short-fallback.ts",
    "execute:pendle:dust": "tsx scripts/execute-pendle-mainnet-dust.ts",
    "execute:pendle:dust-exit": "tsx scripts/execute-pendle-mainnet-dust-exit.ts",
    "execute:hl:micro-hedge": "tsx scripts/execute-hl-mainnet-micro-hedge.ts",
    "execute:usdai:collateral-probe": "tsx scripts/execute-usdai-mainnet-probe.ts",
    "probe:rchain-testnet": "tsx scripts/execute-rchain-testnet-escort-probe.ts",
    "probe:rchain-mainnet": "tsx scripts/execute-rchain-mainnet-escort-probe.ts",
    "probe:robinhood-inbound-treasury": "tsx scripts/execute-robinhood-inbound-treasury-probe.ts",
    "preflight:venues": "tsx scripts/preflight-five-venues.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "build": "pnpm run build:worker",
    "build:assets": "mkdir -p dist/brand && cp index.html dist/index.html && cp public/brand/Logo_BeDeltaLivingWater_small.png dist/brand/ && cp public/brand/Demo_50s.mp4 dist/brand/",
    "build:worker": "pnpm run build:assets && pnpm exec tsc --noEmit && WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --minify --outdir=dist-worker",
    "bundle:measure": "tsx scripts/measure-worker-bundle.ts",
    "verify:5tx": "tsx scripts/verify-5tx.ts",
    "verify:grant": "tsx scripts/verify-5tx-runner.ts",
    "verify:negative": "tsx scripts/verify-negative-proofs.ts",
    "export:dune": "tsx scripts/export-dune-telemetry.ts",
    "export:dune:onchain": "tsx scripts/fetch-onchain-dune-telemetry.ts",
    "emit:dune:onchain:sepolia": "tsx scripts/emit-sepolia-telemetry-events.ts",
    "emit:dune:onchain:mainnet": "tsx scripts/emit-mainnet-telemetry-events.ts",
    "emit:dune:onchain:stylus": "tsx scripts/emit-stylus-mainnet-telemetry-events.ts",
    "emit:dune:onchain:sanctuary": "tsx scripts/emit-sanctuary-telemetry-events.ts",
    "clean:coverage": "node -e \"require('node:fs').rmSync('./coverage', { recursive: true, force: true })\"",
    "dev": "pnpm run build:assets && node scripts/wrangler-dev-guard.mjs",
    "deploy": "pnpm run build:assets && wrangler deploy --minify",
    "cf-typegen": "wrangler types"
  },
  "keywords": [],
  "author": "SilverVine Labs",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250719.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.9",
    "solhint": "^6.2.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  },
  "volta": {
    "node": "20.20.2"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "1.8.0",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/sdk": "^5.5.10",
    "ethers": "^6.17.0",
    "viem": "^2.55.13"
  },
  "packageManager": "pnpm@12.4.1"
}
